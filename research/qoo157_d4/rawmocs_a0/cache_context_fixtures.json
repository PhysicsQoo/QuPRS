{
  "schema_version": 1,
  "kind": "RaWMoCS A0e conditional component cache and weighted counting context adversarial research cases",
  "arithmetic": "exact Gaussian rational, weights are [positive_re,positive_im,negative_re,negative_im], omitted defaults 1+0i",
  "pairs": [
    {
      "id": "order_invariance",
      "assert": "equal",
      "why": "Clause order is not semantic cache identity",
      "left": {
        "mode": "wmc",
        "nvars": 2,
        "clauses": [
          [
            1,
            2
          ],
          [
            -1,
            2
          ]
        ],
        "weights": {
          "1": [
            "2",
            "0",
            "3",
            "0"
          ],
          "2": [
            "0",
            "1",
            "1",
            "0"
          ]
        },
        "expected": {
          "re": "0",
          "im": "5",
          "sat_models": 2,
          "projected_models": null
        }
      },
      "right": {
        "mode": "wmc",
        "nvars": 2,
        "clauses": [
          [
            -1,
            2
          ],
          [
            2,
            1
          ]
        ],
        "weights": {
          "1": [
            "2",
            "0",
            "3",
            "0"
          ],
          "2": [
            "0",
            "1",
            "1",
            "0"
          ]
        },
        "expected": {
          "re": "0",
          "im": "5",
          "sat_models": 2,
          "projected_models": null
        }
      }
    },
    {
      "id": "duplicate_clause",
      "assert": "equal",
      "why": "Duplicate clause is logically idempotent even for arbitrary complex literal weights",
      "left": {
        "mode": "wmc",
        "nvars": 2,
        "clauses": [
          [
            1,
            2
          ]
        ],
        "weights": {
          "1": [
            "2",
            "0",
            "1",
            "0"
          ]
        },
        "expected": {
          "re": "5",
          "im": "0",
          "sat_models": 3,
          "projected_models": null
        }
      },
      "right": {
        "mode": "wmc",
        "nvars": 2,
        "clauses": [
          [
            1,
            2
          ],
          [
            1,
            2
          ]
        ],
        "weights": {
          "1": [
            "2",
            "0",
            "1",
            "0"
          ]
        },
        "expected": {
          "re": "5",
          "im": "0",
          "sat_models": 3,
          "projected_models": null
        }
      }
    },
    {
